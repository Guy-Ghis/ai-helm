flowchart TD
    Req[Request] --> Plan
    
    subgraph PlanLayer [User's Plan Limit]
        Plan{Plan Budget\nExhausted?}
    end
    
    subgraph TierLayer [Project Member Tier Limit]
        Tier{Tier Budget\nExhausted?}
    end
    
    subgraph EnvelopeLayer [Whole Project Envelope]
        Envelope{Envelope Budget\nExhausted?}
    end
    
    Plan -- Yes --> Deny[Deny: 402]
    Plan -- No --> Tier
    
    Tier -- Yes --> Deny
    Tier -- No --> Envelope
    
    Envelope -- Yes --> Deny
    Envelope -- No --> Allow[Allow Request]
    
    style Deny fill:#ffcdd2,stroke:#f44336
    style Allow fill:#e8f5e9,stroke:#4caf50
