flowchart TD
    User([User Request]) --> Envoy[Envoy Gateway]
    
    subgraph Gateway [Core Gateway]
        Auth[Authorino]
        Lua[Lua Budget Limiter]
    end
    
    subgraph SpeedCop [The Speed Cop]
        Lyft[Lyft Ratelimit Service]
        Redis[(Redis: 60s Counters)]
    end
    
    subgraph Bank [The Bank]
        Ledger[(Lightbridge Ledger DB)]
    end
    
    Envoy --> Auth
    Auth -.-> Ledger
    Auth -->|1. Check balance metadata| Lua
    Lua -->|2. Check RPM| Lyft
    Lyft -.-> Redis
    
    Lua -- Balance ≤ 0 --> R402[402 Payment Required]
    Lyft -- Req > 60/min --> R429[429 Too Many Requests]
    Lyft -- Allow --> Backend[AI Model Backend]
    
    style Envoy fill:#f5f5f5,stroke:#9e9e9e
    style Auth fill:#e1f5fe,stroke:#03a9f4
    style Lua fill:#fff3e0,stroke:#ff9800
    style Lyft fill:#fce4ec,stroke:#e91e63
    style R402 fill:#ffcdd2,stroke:#f44336
    style R429 fill:#ffcdd2,stroke:#f44336
    style Backend fill:#e8f5e9,stroke:#4caf50
