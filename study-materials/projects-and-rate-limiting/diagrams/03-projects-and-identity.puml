@startuml
skinparam rectangle {
    BackgroundColor White
}

actor "User with API Key" as User
rectangle "Envoy AI Gateway" as Gateway

package "Identity & Project Resolution" {
    rectangle "Authorino" as Auth #E1F5FE
    rectangle "Keycloak" as Keycloak #FFF3E0
    rectangle "Lightbridge API" as LB #E8F5E9
    database "Lightbridge DB" as DB #E8F5E9
}

User --> Gateway
Gateway --> Auth : 1. Validate Token
Auth .> Keycloak : 2. Token Exchange
Keycloak .> LB : 3. Lookup Project & Plan
LB .> DB

Auth --> Gateway : "4. Attach Headers:\n x-billing-plan\n x-account-id"
@enduml
