@startuml
rectangle Request as Req

package "User's Plan Limit" {
    hexagon "Plan Budget\nExhausted?" as Plan
}

package "Project Member Tier Limit" {
    hexagon "Tier Budget\nExhausted?" as Tier
}

package "Whole Project Envelope" {
    hexagon "Envelope Budget\nExhausted?" as Envelope
}

rectangle "Deny: 402" as Deny #FFCDD2
rectangle "Allow Request" as Allow #E8F5E9

Req --> Plan
Plan --> Deny : Yes
Plan --> Tier : No

Tier --> Deny : Yes
Tier --> Envelope : No

Envelope --> Deny : Yes
Envelope --> Allow : No
@enduml
