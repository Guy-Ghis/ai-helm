@startuml
actor "User Request" as User
rectangle "Envoy Gateway" as Envoy

package "Core Gateway" {
    rectangle Authorino as Auth #E1F5FE
    rectangle "Lua Budget Limiter" as Lua #FFF3E0
}

package "The Speed Cop" {
    rectangle "Lyft Ratelimit Service" as Lyft #FCE4EC
    database "Redis: 60s Counters" as Redis #FCE4EC
}

package "The Bank" {
    database "Lightbridge Ledger DB" as Ledger
}

rectangle "402 Payment Required" as R402 #FFCDD2
rectangle "429 Too Many Requests" as R429 #FFCDD2
rectangle "AI Model Backend" as Backend #E8F5E9

User --> Envoy
Envoy --> Auth
Auth .> Ledger
Auth --> Lua : 1. Check balance metadata
Lua --> Lyft : 2. Check RPM
Lyft .> Redis

Lua --> R402 : Balance <= 0
Lyft --> R429 : Req > 60/min
Lyft --> Backend : Allow
@enduml
