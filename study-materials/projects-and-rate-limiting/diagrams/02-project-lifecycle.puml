@startuml
skinparam sequenceArrowThickness 2
skinparam sequenceBoxBackgroundColor #E3F2FD
skinparam actorBackgroundColor #FFF9C4
skinparam participantBackgroundColor #E8F5E9
skinparam databaseBackgroundColor #FCE4EC
skinparam titleFontSize 16

title Project Lifecycle: Create, Configure, Mint Keys

actor "Admin / User" as U
participant "Lightbridge API\n(Rust service)" as API
database "PostgreSQL\n(Lightbridge DB)" as DB

== Step 1: Create the Project ==
U -> API : POST /projects\n{ name: "Dev Team", billing_plan: "pro" }
API -> DB : INSERT INTO projects\n(account_id, name, billing_plan, model_policy='allow_all')
DB --> API : project_id = "proj-abc"
API --> U : 201 Created { id: "proj-abc" }

== Step 2: Restrict Model Access ==
U -> API : PATCH /projects/proj-abc\n{ model_policy: "allowlist",\n  allowed_models: ["gpt-4o", "claude-3-5-sonnet"] }
API -> DB : UPDATE projects SET\nmodel_policy='allowlist',\nallowed_models='["gpt-4o","claude-3-5-sonnet"]'
DB --> API : OK
API --> U : 200 OK

== Step 3: Add a Team Member ==
U -> API : POST /projects/proj-abc/members\n{ account_id: "user-xyz", role: "member" }
API -> DB : INSERT INTO project_members\n(project_id, account_id, role='member')
DB --> API : OK
API --> U : 200 OK

== Step 4: Mint an API Key ==
U -> API : POST /projects/proj-abc/api-keys\n{ name: "CI Key" }
API -> DB : INSERT INTO api_keys\n(project_id, owner_account_id, key_hash, billing_plan)
DB --> API : key_id = "key-123"
API --> U : 201 Created\n{ id: "key-123", secret: "sk-abc..." }\n\nNOTE: secret shown ONCE, never stored
@enduml
