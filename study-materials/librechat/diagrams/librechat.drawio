        <mxCell id="220" value="Key facts:&#10;- LibreChat NEVER calls AI providers directly&#10;- ALL AI traffic goes through Envoy AI Gateway using the CONVERSE_OPENAI_API_KEY&#10;- Authentication is OIDC only (no email/password login — ALLOW_EMAIL_LOGIN=false)&#10;- Redis is SHARED with other platform services (prefix: librechat-prod-v2)" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;">
          <mxGeometry x="30" y="500" width="850" height="80" as="geometry"/>
        </mxCell>
      </root>
