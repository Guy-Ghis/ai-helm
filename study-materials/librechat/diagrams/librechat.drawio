          <mxGeometry x="60" y="300" width="900" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="225" value="librechat-search&#10;(LEAF 1)&#10;sync-wave: -1&#10;Deploys: Meilisearch&#10;Port: 7700&#10;Secret: librechat-meili-config" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=0;fontSize=13;">
