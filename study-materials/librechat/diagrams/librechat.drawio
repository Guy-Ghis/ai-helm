          <mxGeometry x="60" y="70" width="500" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="223" value="charts/librechart/&#10;(ORCHESTRATOR)&#10;Renders: 1 ApplicationSet&#10;Namespace: argocd&#10;Project: ai&#10;Registry: oci://ghcr.io/adorsys-gis/charts&#10;Values from: ai-helm-values@main" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontStyle=0;fontSize=13;">
          <mxGeometry x="80" y="120" width="460" height="140" as="geometry"/>
