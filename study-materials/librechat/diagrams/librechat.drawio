        </mxCell>
        <mxCell id="227" value="librechat-opencode-wellknown&#10;(LEAF 3)&#10;sync-wave: 1&#10;Deploys: nginx (static)&#10;Serves: well-known JSON&#10;https://ai.camer.digital&#10;  /opencode/.well-known/opencode" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=0;fontSize=13;">
