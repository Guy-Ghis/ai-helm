        <mxCell id="232" value="prod values merged&#10;at render time" edge="1" source="228" target="226" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=8 4;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="233" value="Sync wave order ensures:&#10;  1. Meilisearch (wave -1) is healthy before LibreChat tries to connect to it&#10;  2. LibreChat + MongoDB (wave 0) are healthy before the well-known nginx (wave 1) starts&#10;  3. Agent Seed Job runs AFTER LibreChat is healthy (PostSync hook)&#10;&#10;Each leaf is an independent ArgoCD Application.&#10;prune=true + selfHeal=true: manual cluster changes are reverted automatically." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=12;">
          <mxGeometry x="60" y="510" width="850" height="100" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 — Authentication Flow">
