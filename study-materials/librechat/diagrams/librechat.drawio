        <mxCell id="299" value="Diagram 7 — Agent Seed Job: PostSync Mechanics" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#023047;strokeColor=#023047;fontColor=#ffffff;fontStyle=1;fontSize=14;">
          <mxGeometry x="30" y="20" width="1000" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="300" value="ArgoCD&#10;Sync Complete&#10;Application: Healthy" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontStyle=1;fontSize=13;">
          <mxGeometry x="50" y="100" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="301" value="Job: librechat-app-agent-seed&#10;hook: PostSync&#10;delete-policy: BeforeHookCreation&#10;image: ghcr.io/danny-avila/librechat:v0.8.7&#10;backoffLimit: 3&#10;ttlSecondsAfterFinished: 600" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=13;">
          <mxGeometry x="330" y="80" width="340" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="302" value="triggers&#10;(every sync)" edge="1" source="300" target="301" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="303" value="ConfigMap:&#10;librechat-app-agent-seed-script&#10;→ /seed/seed-agents.js&#10;(the Node.js script)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=0;fontSize=13;">
          <mxGeometry x="330" y="240" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="304" value="ConfigMap:&#10;librechat-app-agent-seed-fleet&#10;→ /fleet/fleet.json&#10;(the agent definitions array)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=0;fontSize=13;">
          <mxGeometry x="620" y="240" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="305" value="mounts" edge="1" source="301" target="303" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="306" value="mounts" edge="1" source="301" target="304" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="307" value="Phase 1: MongoDB direct&#10;Connect to MongoDB&#10;Find platform user by email&#10;Generate a JWT for that user&#10;(uses JWT_SECRET env var)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=0;fontSize=13;">
          <mxGeometry x="50" y="380" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="308" value="script runs" edge="1" source="303" target="307" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="309" value="Phase 2: LibreChat REST API&#10;For each agent in fleet.json:&#10;  GET /api/agents (find by name)&#10;  If exists → PATCH (update)&#10;  If not → POST (create)&#10;Idempotent — safe to re-run" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=0;fontSize=13;">
          <mxGeometry x="400" y="380" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="310" value="then" edge="1" source="307" target="309" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="311" value="LibreChat&#10;REST API&#10;:3080" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;fontStyle=0;fontSize=13;">
          <mxGeometry x="750" y="400" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="312" value="MongoDB" vertex="1" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;">
          <mxGeometry x="100" y="540" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="313" value="direct" edge="1" source="307" target="312" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="314" value="HTTP" edge="1" source="309" target="311" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="315" value="Why PostSync and not Init Container?&#10;  An Init Container runs before the main pod is ready.&#10;  The seed script calls LibreChat's own API — LibreChat must be healthy first.&#10;  PostSync guarantees the Application is Healthy before the Job fires.&#10;&#10;Idempotent: running the seed twice produces the same result.&#10;BeforeHookCreation: old Job deleted before new one created — no orphaned Jobs." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=12;">
          <mxGeometry x="50" y="640" width="700" height="100" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
