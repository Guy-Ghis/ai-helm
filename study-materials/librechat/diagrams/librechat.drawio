        <mxCell id="234" value="Diagram 3 — Authentication Flow: OIDC with Keycloak" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#023047;strokeColor=#023047;fontColor=#ffffff;fontStyle=1;fontSize=14;">
          <mxGeometry x="30" y="20" width="1000" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="235" value="User&#10;(browser)" vertex="1" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;">
          <mxGeometry x="50" y="120" width="40" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="236" value="LibreChat&#10;https://ai.camer.digital" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;fontStyle=1;fontSize=13;">
          <mxGeometry x="230" y="120" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="237" value="Keycloak&#10;https://auth.verif.fyi&#10;/realms/camer-digital&#10;client: converse" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=13;">
          <mxGeometry x="530" y="120" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="238" value="1. Visit ai.camer.digital" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=12;">
          <mxGeometry x="180" y="100" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="239" value="2. Redirect to Keycloak login&#10;(OPENID_AUTO_REDIRECT=true)" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=12;">
          <mxGeometry x="180" y="200" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="240" value="3. User logs in&#10;(SSO / federated)" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=12;">
          <mxGeometry x="430" y="200" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="241" value="4. Authorization code&#10;returned to callback" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=12;">
          <mxGeometry x="430" y="300" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="242" value="5. LibreChat exchanges code&#10;for ID token + refresh token&#10;(OPENID_CALLBACK_URL=/oauth/openid/callback)" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=12;">
          <mxGeometry x="180" y="300" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="243" value="6. Session established&#10;(60-day refresh token)" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=12;">
          <mxGeometry x="180" y="400" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="244" value="LibreChat validates:&#10;  OPENID_REQUIRED_ROLE_PARAMETER_PATH: librechat_roles&#10;  OPENID_REQUIRED_ROLE_TOKEN_KIND: access&#10;  OPENID_AUDIENCE: converse&#10;  OPENID_SCOPE: openid profile email librechat offline_access" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#33691e;fontStyle=0;fontSize=13;">
          <mxGeometry x="420" y="400" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="245" value="Key env vars:&#10;  ALLOW_EMAIL_LOGIN=false   — no username/password&#10;  ALLOW_REGISTRATION=false  — no self-registration&#10;  ALLOW_SOCIAL_LOGIN=true   — OIDC only&#10;  OPENID_USE_END_SESSION_ENDPOINT=true  — proper logout via Keycloak&#10;  LOGIN_MAX=50, LOGIN_WINDOW=1  — max 50 login attempts per minute" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=12;">
          <mxGeometry x="50" y="540" width="600" height="110" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 — Config Delivery">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="246" value="Diagram 4 — Config Delivery: How librechat.yaml Gets Into the Pod" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#023047;strokeColor=#023047;fontColor=#ffffff;fontStyle=1;fontSize=14;">
          <mxGeometry x="30" y="20" width="1000" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="247" value="ai-helm-values@main&#10;(private GitHub repo)&#10;environments/prod/values/librechat-app.yaml&#10;contains the config: key" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontStyle=0;fontSize=13;">
          <mxGeometry x="50" y="80" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="248" value="ArgoCD ApplicationSet&#10;(librechart orchestrator)&#10;merges ai-helm-values config:&#10;into chart at render time&#10;($values pattern ADR-0087)" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontStyle=0;fontSize=13;">
          <mxGeometry x="50" y="230" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="249" value="ConfigMap: librechat-config&#10;data:&#10;  librechat: |    ← single key&#10;    &lt;the full librechat.yaml YAML&gt;" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=0;fontSize=13;">
          <mxGeometry x="50" y="380" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="250" value="LibreChat Pod&#10;mount: /app/librechat.yaml&#10;subPath: librechat  ← single file, not directory&#10;readOnly: true&#10;&#10;⚠️ subPath = NO auto-update on ConfigMap change!" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;fontStyle=1;fontSize=13;">
          <mxGeometry x="50" y="530" width="300" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="251" value="Helm source 2&#10;(valueFiles)" edge="1" source="247" target="248" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="252" value="templates/configmap.yaml&#10;renders {{ with .Values.config }}" edge="1" source="248" target="249" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="253" value="persistence: configMap mount" edge="1" source="249" target="250" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="254" value="ConfigMap: librechat-app-config-rollout&#10;data:&#10;  generation: '1'  ← bump on every config change&#10;&#10;bjw-s stamps checksum/configMaps annotation&#10;on the Deployment pod template.&#10;Changing generation → rolling restart." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=0;fontSize=13;">
          <mxGeometry x="440" y="380" width="380" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="255" value="triggers rolling restart&#10;when generation changes" edge="1" source="254" target="250" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="256" value="Why subPath?&#10;  Without subPath, the entire ConfigMap directory is mounted.&#10;  With subPath, only the single key 'librechat' is mounted as /app/librechat.yaml.&#10;  Side effect: subPath mounts do NOT hot-reload when the ConfigMap changes.&#10;  Solution: bump 'generation' in config-rollout ConfigMap in the same commit as any config change." vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;">
          <mxGeometry x="50" y="660" width="780" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
