          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="325" value="JSON Document contains:&#10;  auth.command: stub (plugin overrides)&#10;  config.default_agent: assistant&#10;  provider: camer-digital&#10;    baseURL: https://api.ai.camer.digital/v1&#10;    oauth2.issuer: Keycloak&#10;    oauth2.clientId: opencode-cli&#10;    oauth2.authFlow: device_code&#10;    rateLimit: tiers (wait ≤120s, error &gt;120s)&#10;  plugins:&#10;    @vymalo/opencode-oauth2@0.12.0&#10;    @vymalo/opencode-ratelimit@0.12.0&#10;    opencode-skills-collection@4.0.14" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#33691e;fontStyle=0;fontSize=13;">
