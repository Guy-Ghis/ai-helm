                    </mxGeometry>
                </mxCell>
                <mxCell id="2306" edge="1" parent="1" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;dashed=1;strokeColor=#757575;fontColor=#616161;" value="10. Later: refresh against Keycloak when tokens expire">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="540" y="570" as="sourcePoint"/>
                        <mxPoint x="920" y="570" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="2307" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=left;spacingLeft=6;" value="8. Find or CREATE the user (match on sub)&#xa;— ALLOW_SOCIAL_REGISTRATION=true&#xa;— keep Keycloak refresh token as session&#xa;  (OPENID_REUSE_TOKENS=true)" vertex="1">
                    <mxGeometry height="62" width="300" x="555" y="458" as="geometry"/>
                </mxCell>
                <mxCell id="245" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#fff9c4;strokeColor=#f57f17;fontSize=12;spacingLeft=6;" value="Key env vars (librechat-app chart):&#xa;  ALLOW_EMAIL_LOGIN=false — no username/password&#xa;  ALLOW_REGISTRATION=false — no local sign-up&#xa;  ALLOW_SOCIAL_LOGIN=true — OIDC login&#xa;  ALLOW_SOCIAL_REGISTRATION=true — account created on first SSO login&#xa;  OPENID_AUTO_REDIRECT=true — skip the login page&#xa;  OPENID_CALLBACK_URL=/oauth/openid/callback&#xa;  REFRESH_TOKEN_EXPIRY=5184000000 (60 days)&#xa;  OPENID_USE_END_SESSION_ENDPOINT=true — logout ends the Keycloak session" vertex="1">
                    <mxGeometry height="190" width="550" x="30" y="620" as="geometry"/>
                </mxCell>
                <mxCell id="244" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#f1f8e9;strokeColor=#33691e;fontSize=12;spacingLeft=6;" value="Token settings &amp; role gate:&#xa;  OPENID_SCOPE: openid profile email librechat offline_access&#xa;  OPENID_AUDIENCE: converse&#xa;  OPENID_REUSE_TOKENS: true&#xa;  OPENID_REQUIRED_ROLE: (commented out — open beta)&#xa;  ⇒ OPENID_REQUIRED_ROLE_PARAMETER_PATH=librechat_roles and&#xa;     OPENID_REQUIRED_ROLE_TOKEN_KIND=access are INERT:&#xa;     any user of the camer-digital realm can log in" vertex="1">
                    <mxGeometry height="190" width="530" x="600" y="620" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="4 — Config Delivery" id="3">
        <mxGraphModel dx="1143" dy="1193" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="246" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#023047;strokeColor=#023047;fontColor=#ffffff;fontStyle=1;fontSize=14;" value="Diagram 4 — Config Delivery: How librechat.yaml Gets Into the Pod" vertex="1">
                    <mxGeometry height="38" width="1100" x="30" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="247" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontStyle=0;fontSize=13;" value="ai-helm-values@main&#xa;(private GitHub repo)&#xa;environments/prod/values/librechat-app.yaml&#xa;contains the config: key" vertex="1">
                    <mxGeometry height="95" width="340" x="40" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="248" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontStyle=0;fontSize=13;" value="ArgoCD ApplicationSet&#xa;(librechart orchestrator)&#xa;merges ai-helm-values config:&#xa;into chart at render time&#xa;($values pattern ADR-0087)" vertex="1">
                    <mxGeometry height="105" width="340" x="40" y="235" as="geometry"/>
                </mxCell>
                <mxCell id="249" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=0;fontSize=13;" value="ConfigMap: librechat-config&#xa;data:&#xa;  librechat: |    ← single key&#xa;    &lt;the full librechat.yaml YAML&gt;" vertex="1">
                    <mxGeometry height="95" width="340" x="40" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="250" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0277bd;fontStyle=1;fontSize=13;" value="LibreChat Pod&#xa;mount: /app/librechat.yaml&#xa;subPath: librechat  ← single file, not directory&#xa;readOnly: true&#xa;&#xa;⚠️ subPath = NO auto-update on ConfigMap change!" vertex="1">
                    <mxGeometry height="130" width="340" x="40" y="555" as="geometry"/>
                </mxCell>
                <mxCell id="251" edge="1" parent="1" source="247" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="248" value="Helm source 2&#xa;(valueFiles)">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="252" edge="1" parent="1" source="248" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="249" value="templates/configmap.yaml&#xa;renders {{ with .Values.config }}">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="253" edge="1" parent="1" source="249" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="250" value="persistence: configMap mount">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="254" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=0;fontSize=13;" value="ConfigMap: librechat-app-config-rollout&#xa;data:&#xa;  generation: &#39;14&#39;  ← live value; bump on EVERY config change&#xa;&#xa;bjw-s stamps checksum/configMaps annotation&#xa;on the Deployment pod template.&#xa;Changing generation → rolling restart." vertex="1">
                    <mxGeometry height="130" width="400" x="480" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="255" edge="1" parent="1" source="254" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="250" value="triggers rolling restart&#xa;when generation changes">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="680" y="620"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="256" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;" value="Why subPath?&#xa;  Without subPath, the entire ConfigMap directory is mounted.&#xa;  With subPath, only the single key &#39;librechat&#39; is mounted as /app/librechat.yaml.&#xa;  Side effect: subPath mounts do NOT hot-reload when the ConfigMap changes.&#xa;  Solution: bump &#39;generation&#39; in config-rollout ConfigMap in the same commit as any config change." vertex="1">
                    <mxGeometry height="80" width="1090" x="40" y="720" as="geometry"/>
                </mxCell>
                <mxCell id="2560" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e8f5e9;strokeColor=#2e7d32;" value="How to change the LibreChat config (the safe way):&#xa;  1. Edit config: in ai-helm-values environments/prod/values/librechat-app.yaml&#xa;  2. In the SAME commit bump librechat.configMaps.config-rollout.data.generation (&quot;14&quot; → &quot;15&quot;)&#xa;  3. Merge → ArgoCD syncs → ConfigMap + checksum annotation change → pods roll one by one&#xa;  Forget step 2 and the change sits in the ConfigMap but is never loaded." vertex="1">
                    <mxGeometry height="110" width="650" x="480" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="2561" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffebee;strokeColor=#c62828;" value="⚠ Values-repo FIRST: if librechat-app.yaml is missing, ignoreMissingValueFiles renders the chart&#xa;with NO config: → the configmap.yaml &#39;with&#39; guard emits NO ConfigMap → LibreChat starts&#xa;with no endpoints (broken chat, not a failed sync)." vertex="1">
                    <mxGeometry height="80" width="650" x="480" y="235" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
