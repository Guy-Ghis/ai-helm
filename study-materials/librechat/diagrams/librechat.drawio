                <mxCell id="220" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;" value="Key facts (verified 2026-10-05):&#xa;- LibreChat NEVER calls AI providers directly — every call goes to the internal Envoy AI Gateway&#xa;- One key authenticates LibreChat, but X-LibreChat-User makes rate limits + dashboards PER USER&#xa;- Login is Keycloak OIDC only (no email/password); role gate (OPENID_REQUIRED_ROLE) is OFF (open beta)&#xa;- Image generation withdrawn 2026-09-15 (ADR-0138)" vertex="1">
                    <mxGeometry height="150" width="700" x="30" y="430" as="geometry"/>
                </mxCell>
