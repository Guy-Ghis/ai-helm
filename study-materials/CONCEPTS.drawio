                <mxCell id="OnmnXBfdHe-ymCt0516s-26" value="validates against a const&lt;div&gt;X&amp;nbsp;&lt;/div&gt;&lt;div&gt;X1&lt;/div&gt;&lt;div&gt;X2&lt;br&gt;(Token equivalent of 30$)&lt;/div&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;" parent="1" vertex="1">
