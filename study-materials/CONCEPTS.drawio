                <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;flowchart TB\n    subgraph K8S[\&quot;Kubernetes API (etcd)\&quot;]\n        CRDs[\&quot;Gateway API + EG + AIEG resources\&quot;]\n        ES[\&quot;EndpointSlices, Secrets, Services\&quot;]\n    end\n\n    subgraph CP[\&quot;Control plane — envoy-gateway-system\&quot;]\n        EG[\&quot;Envoy Gateway controller&lt;br/&gt;xDS server :18000&lt;br/&gt;ratelimit xDS :18001\&quot;]\n        AIEG[\&quot;AIEG controller&lt;br/&gt;Extension Manager server\&quot;]\n    end\n\n    subgraph POD[\&quot;Each Envoy pod (fleet of 3–5, HPA)\&quot;]\n        BOOT[\&quot;Bootstrap via --config-yaml:&lt;br/&gt;node = converse-gateway/core-gateway&lt;br/&gt;xds_cluster = envoy-gateway:18000&lt;br/&gt;admin 127.0.0.1:19000 · stats :19001\&quot;]\n        ENVOY[\&quot;envoy\&quot;]\n        CERTS[\&quot;/certs Secret 'envoy'&lt;br/&gt;/sds ConfigMap (file-based SDS)\&quot;]\n    end\n\n    CRDs --&gt; EG\n    ES --&gt; EG\n    EG &lt;--&gt;|\&quot;hook calls:&lt;br/&gt;modify xDS\&quot;| AIEG\n    BOOT --&gt; ENVOY\n    CERTS --&gt;|\&quot;mTLS client cert&lt;br/&gt;+ trusted CA, SAN = envoy-gateway\&quot;| ENVOY\n    ENVOY ==&gt;|\&quot;Envoy dials EG and opens one&lt;br/&gt;DELTA_GRPC ADS stream&lt;br/&gt;LDS · RDS · CDS · EDS · SDS\&quot;| EG\n    EG -.-&gt;|\&quot;pushes changes&lt;br/&gt;Envoy replies ACK / NACK\&quot;| ENVOY&quot;,&#10;  &quot;config&quot;: null&#10;}" id="LLRd4zqEJQa3BD5fmoPJ-27">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
